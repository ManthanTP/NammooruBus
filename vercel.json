{
  "headers": [
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nammooru-bus.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/.*|assets/.*|brand/.*|icons/.*|favicon.*|sw\\.js|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
