# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional alias if using Supabase publishable key format
VITE_SUPABASE_PUBLISHABLE_KEY=

# Map Configuration (OpenStreetMap Humanitarian - 100% free, no key required)
VITE_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, <a href="https://www.hotosm.org/">HOT</a>

# Default Map Center (Hubballi, Karnataka)
VITE_DEFAULT_LAT=15.3647
VITE_DEFAULT_LNG=75.1240

# App URL
VITE_APP_URL=http://localhost:5173

# Secondary access key for hidden admin login (/12345678/admin/login)
VITE_ADMIN_SECRET_KEY=nammooru-admin-secret-2026

# Dev tools flag (true/false)
VITE_DEV_TOOLS=true
